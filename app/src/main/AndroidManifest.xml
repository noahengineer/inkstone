<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission yet. It arrives with M5, together with the
      Nextcloud client, so that M0-M4 cannot accidentally acquire a network
      code path outside the outbox (CLAUDE.md rule 4).
    -->

    <application
        android:name=".InkstoneApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inkstone">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:label="@string/app_name"
            android:theme="@style/Theme.Inkstone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The editor (M3). Its own activity so that "which note" survives a process kill
          through the intent extras, and so that leaving a note is an onStop — which is
          where SPEC §5.1 materializes and where §5.7 redraws the thumbnail.
        -->
        <activity
            android:name=".note.NoteActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Inkstone" />
    </application>

</manifest>
