<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      M5. The only outbound traffic is the user's own Nextcloud (SPEC §14: "note content
      goes nowhere except the user's own server"), and every remote *mutation* goes
      through the outbox (CLAUDE.md rule 4). ACCESS_NETWORK_STATE is WorkManager's, for
      the CONNECTED constraint that keeps the drainer from being woken with no network —
      and NetworkStatus's, so the recognition model's panel can say a download is waiting
      for a connection rather than drawing progress that is not happening. It never gates
      a request.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      M12 — lecture recording (docs/M12-AUDIO.md §9).

      Four permissions and each is a different requirement, which is worth spelling out because
      three of them are new kinds of thing for this app:

        RECORD_AUDIO             runtime, dangerous. Asked for at the first press of the record
                                 button — this is the app's first runtime permission of any kind.
        FOREGROUND_SERVICE       normal. Required to run one at all since API 28.
        FOREGROUND_SERVICE_MICROPHONE
                                 normal, but required *per type* since API 34 — and targetSdk is
                                 36, so without it `startForeground(..., TYPE_MICROPHONE)` throws
                                 SecurityException rather than degrading. The service is what
                                 keeps capture alive when the screen goes off, which is the whole
                                 of §9's "the first screen timeout mid-lecture costs the rest of
                                 the lecture".
        POST_NOTIFICATIONS       runtime since API 33. ⚠️ Denying it does **not** stop the
                                 recording — a foreground service still runs — it only hides the
                                 notification. That is the privacy version of §10's failure, so
                                 it is requested alongside the microphone rather than deferred.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      largeHeap (2026-10, docs/NOTE-STAYS-LOADED.md). Without it the heap limit is
      `dalvik.vm.heapgrowthlimit`, 256m on the Galaxy Tab S9 FE+. ActivityThread's GC watcher asks
      the system to destroy this app's stopped activities whenever a collection leaves the heap
      above three quarters of that limit, 192 MB. The physics note alone holds most of that, so
      putting the Element editor on top of it, or switching to another app, got the note's screen
      destroyed (`wm_destroy_activity … low-mem`). Coming back reloaded the whole note, and once
      it ran out of memory doing that. With largeHeap the limit is `dalvik.vm.heapsize`, 512m on
      the tablet, so the watcher fires at 384 MB.
      The working set is the notes themselves and nothing here grows to fill the space.
      `PageAssetCache`'s budget derives from the limit, but it hits its 256 MiB ceiling, and those
      pixels live in native memory anyway.
    -->
    <application
        android:name=".InkstoneApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inkstone"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:label="@string/app_name"
            android:theme="@style/Theme.Inkstone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The editor (M3). Its own activity so that "which note" survives a process kill
          through the intent extras, and so that leaving a note is an onStop with isFinishing.
          That stop is where SPEC §5.1 materializes and where §5.7 redraws the thumbnail. Any
          other stop only saves; see NoteEditorViewModel.onStopped.

          smallestScreenSize (2026-10): split screen, pop-up view and every window resize change
          it, and without it each one recreated this activity. The view model survives that, but
          the ink surface does not, so the page was rebuilt from scratch: the whole loading chip
          on a big note.
        -->
        <activity
            android:name=".note.NoteActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.Inkstone" />

        <!--
          How the published PDF leaves the app (SPEC §5.2 — "opens in any PDF viewer,
          emailed to anyone"). Notes live in private storage, so without this there is no
          way for a user to get one out, and ROADMAP M4's export criterion is unreachable.

          `exported="false"` with `grantUriPermissions`: no other app may enumerate this
          provider, and one only gets access to the single Uri handed to it by a chooser,
          for as long as that grant lasts.
        -->
        <!--
          M12 §9 — the foreground service that keeps a lecture recording.

          `foregroundServiceType="microphone"` is what permits capture to continue once the app is
          not visible; without it the audio silently becomes silence the moment the screen dims.
          Not exported and not bound: it is started, it holds the notification, and
          `RecordingController` owns everything else (see RecordingService's KDoc).

          Deliberately in the **default** process. M6's lesson is the opposite case — the app could
          not start in a secondary process at all, because WorkManager's ContentProvider initializer
          only runs in the default one — and a recorder in its own process would meet the same wall
          and would also be unable to see the controller that owns its state.
        -->
        <service
            android:name=".audio.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          docs/HANDWRITING-SYNTHESIS.md H5 — one personalisation pass now, from adb only. Guarded by
          DUMP, which the shell holds and no installed app can be granted, so nothing on the device can
          send it: see PersonaliseNowReceiver for why a release build needs it at all.
        -->
        <receiver
            android:name=".handwriting.PersonaliseNowReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
