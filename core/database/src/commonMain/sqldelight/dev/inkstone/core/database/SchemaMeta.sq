-- M0's table. The schema was deliberately near-empty until something needed it.
--
--   M2  nothing — a note's truth is its bundle and journal on disk (SPEC §5.1),
--       not a table, so M2 came and went without one.
--   M3  folder / note — the library index. See Library.sq and 1.sqm.
--   M5  remote_binding / outbox (SPEC §7.6). `note` already has its columns.
--
-- This table predates the library index and is kept because dropping it would be a
-- migration that buys nothing. `InkstoneDatabase.Schema.version` — not this row — is
-- what SQLDelight migrates on; this is the *bundle* schema version (SPEC §5.8), which
-- is a different number about a different format.

CREATE TABLE schemaMeta (
    id INTEGER NOT NULL PRIMARY KEY,
    schemaVersion INTEGER NOT NULL
);

selectSchemaVersion:
SELECT schemaVersion FROM schemaMeta WHERE id = 1;

upsertSchemaVersion:
INSERT OR REPLACE INTO schemaMeta(id, schemaVersion) VALUES (1, ?);
