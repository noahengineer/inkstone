-- The folder browser remembers the server's tree, so an upload path can be chosen offline.
--
-- Additive, like 6.sqm and 8.sqm: one new table and one index, nothing altered, so an upgrade
-- cannot mis-default a column that already holds user data. It starts empty — which reads as
-- "I have never seen inside any folder", exactly the state of an install that has never opened
-- the browser, and the browser draws that as such rather than as "no folders".
--
-- Column-by-column reasoning is in Sync.sq, including the one thing worth repeating here:
-- this is **not** `remoteDirectory`. That table is the reconciler's prune cache and a row it
-- did not earn stops a subtree being walked; this one only decides what a picker draws.

CREATE TABLE browsedFolder (
    accountId  TEXT    NOT NULL,
    path       TEXT    NOT NULL,
    parentPath TEXT    NOT NULL,
    name       TEXT    NOT NULL,
    ocId       TEXT,
    seenAt     INTEGER NOT NULL DEFAULT 0,
    listedAt   INTEGER NOT NULL DEFAULT 0,
    pending    INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (accountId, path)
);

CREATE INDEX browsedFolderByParent ON browsedFolder(accountId, parentPath);
